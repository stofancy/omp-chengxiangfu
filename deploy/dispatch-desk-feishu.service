# systemd 用户服务：接收 config.json 中 bot: true 的飞书账号发给机器人的消息，以及任务登记的群消息。把 <bun>、<repo>、<lark-cli-bin-dir> 换成实际路径后放到 ~/.config/systemd/user/，
# 再 systemctl --user enable --now dispatch-desk-feishu；WSL 等无登录会话的环境还要 loginctl enable-linger。
[Unit]
Description=omp-dispatch-desk：飞书机器人入口与群消息监听
After=network-online.target

[Service]
Environment=PATH=<lark-cli-bin-dir>:/usr/local/bin:/usr/bin:/bin
ExecStart=<bun> <repo>/sources/feishu_socket.ts
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
